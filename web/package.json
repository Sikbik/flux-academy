{
  "name": "flux-academy-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "description": "Flux Academy: the web app.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "content:check": "vitest run src/content",
    "shot": "node scripts/shot.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "crawl": "node scripts/lesson-crawl.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "visual": "node scripts/visual-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.10.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
