# Flux Academy server configuration. Every variable is optional; the values shown are the defaults.
# The server reads process.env only (it does not load .env files). To use this file:
#   set -a; . server/.env; set +a; npm --prefix server start

# --- listener ---------------------------------------------------------------------------------
PORT=42069
HOST=0.0.0.0
# The built web app. Default is ../web/dist next to server/ (the image sets /app/web).
# WEB_DIST=../web/dist
# debug | info | warn | error | silent. One JSON object per line on stdout.
LOG_LEVEL=info

# --- security ---------------------------------------------------------------------------------
# Number of trusted reverse proxy hops (true = 1, or 1..9). Only then is X-Forwarded-For used (the entry
# that many hops from the right) and HSTS sent for X-Forwarded-Proto: https. Leave unset when the port is
# reachable directly.
# TRUST_PROXY=1
# Browser origins allowed to read the API cross-origin (comma separated), or *. Unset = no CORS headers
# (the web app is same-origin).
# CORS_ORIGINS=https://example.com
# Token bucket per client address: GET routes and pages, then POST routes (much smaller), then the build
# files a page loads (scripts, styles, fonts, art: many per visit, so a much larger bucket). /healthz is exempt.
RATE_LIMIT_BURST=150
RATE_LIMIT_RPS=30
RATE_LIMIT_WRITE_BURST=30
RATE_LIMIT_WRITE_RPS=3
RATE_LIMIT_STATIC_BURST=1500
RATE_LIMIT_STATIC_RPS=300
# POST body cap in bytes.
BODY_LIMIT_BYTES=65536
# Server-Sent Events caps and slow consumer threshold (bytes queued per client).
SSE_MAX_CLIENTS=2000
SSE_MAX_PER_IP=8
SSE_MAX_BUFFER_BYTES=262144
SSE_HEARTBEAT_MS=20000
# Cap for the in-memory brotli/gzip cache (bytes).
COMPRESS_CACHE_BYTES=33554432

# --- offline mode (dev and CI only, never in production) -----------------------------------------
# 1 = no upstream calls; simulated data labelled "fallback"; a simulated block every 30 s.
FIXTURES=0

# --- upstreams ----------------------------------------------------------------------------------
# Flux API bases (comma separated, tried in order), the stats service, the rates service FluxOS prices
# with, and CoinGecko (24 h change, market cap, and the price when the rates service is down).
FLUX_API_URLS=https://api.runonflux.io
FLUX_STATS_URL=https://stats.runonflux.io
MARKET_URL=https://viprates.runonflux.io
MARKET_FALLBACK_URL=https://api.coingecko.com
UPSTREAM_TIMEOUT_MS=10000
# UPSTREAM_USER_AGENT=FluxAcademy/2.0 (+https://academy.app.runonflux.io)

# --- refresh intervals (ms) ------------------------------------------------------------------------
# Block detection: poll gap while a block is due, and for ~22 s right after one.
BLOCK_POLL_FAST_MS=3000
BLOCK_POLL_SLOW_MS=5000
# Node counts by tier.
NETWORK_REFRESH_MS=10000
# Capacity, versions and geography (one stats request, about 90 KB brotli).
GEO_REFRESH_MS=300000
PRICE_REFRESH_MS=60000
# Apps running and registered (large responses; registered is a conditional request).
APPS_RUNNING_REFRESH_MS=600000
APPS_REGISTERED_REFRESH_MS=1800000
